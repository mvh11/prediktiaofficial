# Copy to .env.local and adjust. All values are optional.

# Base URL the browser uses for API calls. Defaults to "/api" (same-origin,
# forwarded by the dev/preview proxy below or by the production reverse proxy).
# Set it to an empty value to run the UI with the data source explicitly
# disabled: data views will show an honest "not configured" state.
VITE_API_BASE_URL=/api

# Per-request timeout in milliseconds (1000-60000). Defaults to 10000.
VITE_API_TIMEOUT_MS=10000

# Dev/preview server only (never sent to the browser): where /api is proxied.
PREDIKTIA_API_PROXY_TARGET=http://127.0.0.1:8000
