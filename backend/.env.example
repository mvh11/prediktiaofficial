# Copia este archivo como .env y rellena los valores.
# NUNCA subas el archivo .env a Git.

# Formato: postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
# Ejemplo local: postgresql+psycopg://postgres:tu_password@localhost:5432/prediktia
DATABASE_URL=

# API-Football (https://www.api-football.com) -> panel de cuenta en dashboard.api-football.com
API_FOOTBALL_KEY=

# 5DollarFootballAPI (https://5dollarfootballapi.com)
FIVE_DOLLAR_FOOTBALL_API_KEY=

# Solo para tests: BD de pruebas separada (nunca la de desarrollo/producción).
# Si falta, los tests marcados "db" se saltan.
# TEST_DATABASE_URL=
